import "std/slice.znn";
import "std/builtin_types.znn";
import "std/optional.znn";
import "std/range.znn";

embed {
#include <regex>
}

export [@member]
extern int size(string*);

export [@member]
extern bool empty(string*);

export string suffix(string* s, int length) {
  return s^.substring(s^.end() - length);
}

export string prefix(string* s, int length) {
  return s^.substring(s^.begin(), length);
}

export bool starts_with(string* s, string* suffix) {
  return s^.begin().is_prefix(suffix^.begin());
}

export bool ends_with(string* s, string* suffix) {
  return s^.end().is_suffix(suffix^.end());
}

export bool contains(string* s, string_iterator it, string* substring) {
  return it.is_prefix(substring^.begin());
}

export bool contains_slow(string* s, int index, string* substring) {
  return s^.contains(s^.begin() + index, substring);
}

export string insert(string* s, string_iterator start, string content) {
  return s^.substring(s^.begin(), start) + move(content) + s^.substring(start);
}

export string insert_slow(string* s, int start, string content) {
  return s^.insert(s^.begin() + start, move(content));
}

export string_iterator? find(string* s, string pattern) {
  return s^.find(&pattern);
}

export string_iterator? find(string* s, string* pattern) {
  return s^.find(s^.begin(), pattern);
}

export string? replace(string* s, string* pattern, string* by) {
  mutable string? ret = null;
  embed {
    try {
      std::regex r(pattern->data());
      auto value = std::regex_replace(s->data(), r, by->data());
      ret = zenon_string::owned(value.data());
    } catch (std::regex_error&) {
    }
  }
  return move(ret);
}

export [@member]
extern char operator [](string*, int index);

[@member]
extern char chat_at_index(string*, int char_index);

export byte[] slice(string* s) embed {
  return slice_t<int8_t>{(int8_t*)&s->data()[0], (int8_t*)&s->data()[s->buffer_size()]};
}

export int get_hash(string* s) {
  return s^.slice().get_hash();
}

embed {
#include <cstdlib>
}

export struct string_iterator {
  string v;
  int char_index;
  int index;
};

export string_iterator implicit_copy(string_iterator*) = default;

export string_iterator begin(string* s) {
  return string_iterator(*s, 0, 0);
}

export string_iterator end(string* s) embed {
  return string_iterator{*s, s->buffer_size(), s->size()};
}

export char operator *(string_iterator* it) embed {
  return it->v.char_at_index(it->char_index);
}

export void operator ++(string_iterator mutable* it) embed {
  it->char_index = it->v.next_char(it->char_index);
  if (it->char_index > it->v.buffer_size())
    throw std::runtime_error("Incremented string iterator beyond bounds");
  ++it->index;
}

export void operator --(string_iterator mutable* it) embed {
  it->char_index = it->v.prev_char(it->char_index);
  if (it->index <= 0)
    throw std::runtime_error("Decremented string iterator beyond bounds");
  --it->index;
}

export string_iterator operator +(mutable string_iterator it, int increment) {
  if (increment < 0)
    return it - (-increment);
  embed {
    for (int i = 0; i < increment; ++i) {
      if (it.char_index == it.v.buffer_size())
        break;
      it.char_index = it.v.next_char(it.char_index);
      ++it.index;
    }
    return it;
  }
}

export string_iterator operator -(mutable string_iterator it, int decrement) {
  if (decrement < 0)
    return it + (-decrement);
  embed {
    for (int i = 0; i < decrement; ++i) {
      if (it.char_index == 0)
        break;
      it.char_index = it.v.prev_char(it.char_index);
      --it.index;
    }
    return it;
  }
}

export bool operator == (string_iterator* it1, string_iterator* it2) {
  return it1^.char_index == it2^.char_index;
}

export bool operator < (string_iterator* it1, string_iterator* it2) {
  return it1^.char_index < it2^.char_index;
}

export string substring(string* s, string_iterator begin, string_iterator end) embed {
  return s->substring(begin.char_index, end.char_index);
}

export string substring_slow(string* s, int begin, int length) {
  return s^.substring(s^.begin() + begin, s^.begin() + begin + length);
}

export string substring(string* s, string_iterator start, int length) {
  return s^.substring(start, start + length);
}

export string substring(string* s, string_iterator start) {
  return s^.substring(start, s^.end());
}

export string substring_slow(string* s, int start) {
  return s^.substring(s^.begin() + start, s^.end());
}

bool is_prefix(mutable string_iterator s, mutable string_iterator prefix) {
  while (prefix != prefix.v.end()) {
    if (s == s.v.end() || *s != *prefix)
      return false;
    ++s;
    ++prefix;
  }
  return true;
}

bool is_suffix(mutable string_iterator s, mutable string_iterator suffix) {
  while (true) {
    if (suffix == suffix.v.begin())
      break;
    if (s == s.v.begin())
      return false;
    --s;
    --suffix;
    if (*suffix != *s)
      return false;
  }
  return true;
}

export string_iterator? find(string* s, string_iterator start, string pattern) {
  return s^.find(move(start), &pattern);
}

export string_iterator? find_slow(string* s, int start, string pattern) {
  return s^.find(s^.begin() + start, &pattern);
}

export string_iterator? find(string* s, mutable string_iterator start, string* pattern) {
  while (start != s^.end()) {
    if (start.is_prefix(pattern^.begin()))
      return move(start);
    ++start;
  }
  return null;
}

export string_iterator? find_slow(string* s, int start, string* pattern) {
  return s^.find(s^.begin() + start, pattern);
}
